<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">
 <!--    해당 설정파일에서 사용하는 프로퍼티-->
    <Properties>
        <Property name="logNm">DHN_Client</Property>
        <Property name="layoutPattern">%style{%d{yyyy/MM/dd HH:mm:ss,SSS}}{cyan} %highlight{[%-5p]}{FATAL=bg_red, ERROR=red,
            INFO=yellow, DEBUG=blue}  [%C] %style{[%t]}{yellow}- %m%n -</Property>
    </Properties>
  <!--    LogEvent를 전달해주는 Appender-->
    <Appenders>
        <Console name="Console_Appender" target="SYSTEM_OUT">
            <PatternLayout pattern="${layoutPattern}"/>
        </Console>
        <RollingFile name="File_Appender" fileName="logs/${logNm}.log" filePattern="logs/${logNm}_%d{yyyy-MM-dd}.log.gz">
            <PatternLayout pattern="${layoutPattern}"/>
            <Filters>
                <!-- ✅ 환경 변수로 SQL 유형별 로그 제어 -->
                <RegexFilter regex=".*SELECT .*" onMatch="${sys:LOG_EXCLUDE_SELECT:-ACCEPT}" onMismatch="ACCEPT"/>
                <RegexFilter regex=".*INSERT .*" onMatch="${sys:LOG_EXCLUDE_INSERT:-ACCEPT}" onMismatch="ACCEPT"/>
                <RegexFilter regex=".*UPDATE .*" onMatch="${sys:LOG_EXCLUDE_UPDATE:-ACCEPT}" onMismatch="ACCEPT"/>
                <RegexFilter regex=".*DELETE .*" onMatch="${sys:LOG_EXCLUDE_DELETE:-ACCEPT}" onMismatch="ACCEPT"/>
                <RegexFilter regex=".*CREATE .*" onMatch="${sys:LOG_EXCLUDE_CREATE:-ACCEPT}" onMismatch="ACCEPT"/>
                <RegexFilter regex=".*DROP .*" onMatch="${sys:LOG_EXCLUDE_DROP:-ACCEPT}" onMismatch="ACCEPT"/>
                <RegexFilter regex=".*ALTER .*" onMatch="${sys:LOG_EXCLUDE_ALTER:-ACCEPT}" onMismatch="ACCEPT"/>
            </Filters>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
            </Policies>
            <DefaultRolloverStrategy max="30" fileIndex="min">
                <Delete basePath="logs" maxDepth="1">
                    <IfFileName glob="DHN_Client_*.log.gz"/>
                    <IfAccumulatedFileCount exceeds="30"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
    </Appenders>
  <!--    실제 Logger-->
    <Loggers>
        <Root level="INFO" additivity="false">
            <AppenderRef ref="Console_Appender"/>
            <AppenderRef ref="File_Appender"/>
        </Root>
        <Logger name="org.springframework" level="WARN" additivity="false">
            <AppenderRef ref="Console_Appender" />
            <AppenderRef ref="File_Appender"/>
        </Logger>
       <!-- 
       <Logger name="org.apache" level="ERROR" additivity="false">
            <AppenderRef ref="Console_Appender" />
            <AppenderRef ref="File_Appender"/>
        </Logger>
        -->
        <Logger name="com.dhn" level="INFO" additivity="false">
            <AppenderRef ref="Console_Appender" />
            <AppenderRef ref="File_Appender"/>
        </Logger>

    </Loggers>
</Configuration>